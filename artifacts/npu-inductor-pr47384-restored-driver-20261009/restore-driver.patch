     return _dynamo.has_triton(**kwargs)
 
 
+def _patch_triton_driver():
+    if not _dynamo.has_triton():
+        return
+    from triton.backends import backends
+    from triton.runtime import driver
+
+    backend = backends.get("ascend")
+    if backend is not None:
+        # CUDA aliases would otherwise make both drivers appear active. Keep
+        # this patch in transfer_to_npu: regular NPU Inductor does not need to
+        # change the upstream helper, while translated CUDA tests do.
+        driver.set_active(backend.driver())
+        from torch._inductor.runtime import triton_helpers
+
+        triton_helpers.set_driver_to_gpu = _patch_triton_driver
+
+
