module attributes {hacc.target = #hacc.target<"Ascend950PR_9579">} {
  tt.func public @barrier_component(%W: !tt.ptr<i32> loc("W"(#loc)), %Y: !tt.ptr<i32> loc("Y"(#loc)), %Sem: !tt.ptr<i32> loc("Sem"(#loc))) attributes {noinline = false} {
    %c1_i32 = arith.constant 1 : i32 loc(#loc1)
    %c4_i32 = arith.constant 4 : i32 loc(#loc1)
    %c0_i32 = arith.constant 0 : i32 loc(#loc1)
    %pid = tt.get_program_id x : i32 loc(#loc15)
    %0 = tt.addptr %W, %pid : !tt.ptr<i32>, i32 loc(#loc3)
    scf.for %phase = %c0_i32 to %c4_i32 step %c1_i32  : i32 {
      %4 = arith.addi %phase, %pid : i32 loc(#loc4)
      tt.store %0, %4 : !tt.ptr<i32> loc(#loc5)
      hivm.hir.sync_block[<ALL_VECTOR>, 0 : index] tvector_pipe = <PIPE_ALL> vector_pipe = <PIPE_ALL> loc(#loc6)
    } loc(#loc1)
    %1 = tt.addptr %Y, %pid : !tt.ptr<i32>, i32 loc(#loc7)
    %2 = tt.addptr %W, %pid : !tt.ptr<i32>, i32 loc(#loc8)
    %3 = tt.load %2 : !tt.ptr<i32> loc(#loc9)
    tt.store %1, %3 : !tt.ptr<i32> loc(#loc10)
    tt.return loc(#loc11)
  } loc(#loc)
} loc(#loc)
