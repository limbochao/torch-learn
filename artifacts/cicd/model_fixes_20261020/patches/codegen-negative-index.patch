@@ -0,0 +1,44 @@
+from contextlib import ExitStack
+from types import SimpleNamespace
+from unittest import mock
+
+import sympy
+import torch
+from torch._inductor.codegen.triton import TritonCSEVariable, TritonKernel
+from torch._inductor.virtualized import V
+from torch.testing._internal.common_utils import TestCase, run_tests
+from torch.utils._sympy.value_ranges import ValueRanges
+
+from torch_npu._inductor.codegen.triton import NPUIndexTritonKernel
+
+
+class TestNegativeIndexCodegen(TestCase):
+    def test_no_wrap_preserves_negative_bounds_and_checks(self):
+        kernel = object.__new__(NPUIndexTritonKernel)
+        kernel.exit_stack = ExitStack()
+        kernel.compute = object()
+        kernel.check_bounds = mock.Mock()
+        bounds = ValueRanges(-2, 3)
+        value = TritonCSEVariable('tmp0', bounds, torch.int64, (8,))
+        result = TritonCSEVariable('tmp1', bounds, torch.int64, (8,))
+        kernel.cse = SimpleNamespace(generate=mock.Mock(return_value=result))
+        parent = SimpleNamespace(indirect_indexing=mock.Mock(return_value=sympy.Symbol('tmp1')))
+        kernel.overrides = lambda: parent
+        with (
+            mock.patch.object(TritonKernel, '__enter__'),
+            mock.patch('torch_npu._inductor.codegen.triton.generate_assert', return_value=True),
+            V.set_interpreter_handler(SimpleNamespace(current_node=None)),
+        ):
+            try:
+                kernel.__enter__()
+                V.ops.indirect_indexing(value, 8, check=True, wrap_neg=False)
+            finally:
+                kernel.exit_stack.close()
+        kernel.cse.generate.assert_called_once_with(
+            kernel.compute, value, bounds=bounds, dtype=torch.int64, shape=(8,)
+        )
+        kernel.check_bounds.assert_called_once_with(sympy.Symbol('tmp1'), sympy.Integer(8), True, False)
+
+
+if __name__ == '__main__':
+    run_tests()
