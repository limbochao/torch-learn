+import torch
+import torch_npu  # noqa: F401
+from torch.testing._internal.common_utils import TestCase, run_tests
+
+from torch_npu._inductor.codegen.triton_utils import NPUKernelType
+from torch_npu._inductor.runtime.tile_generator import TileGenerator
+
+
+class TestTileGeneratorResources(TestCase):
+    def test_mixed_mode_searches_below_simt_limit(self):
+        generator = TileGenerator(
+            [67108864], ['x'], [0], [], [0], [0], False, torch.float32,
+            NPUKernelType.SIMD_SIMT_MIX, input_ptr_num=2,
+        )
+        generator.set_kernel_type(NPUKernelType.SIMT_ONLY)
+        simt = generator.descend_split_tiling()
+        self.assertTrue(simt)
+        self.assertTrue(all(cfg.kwargs['XBLOCK_SUB'] <= 2048 for cfg in simt))
+        generator.set_kernel_type(NPUKernelType.SIMT_TEMPLATE)
+        template = generator.descend_split_tiling()
+        self.assertTrue(template)
+        self.assertTrue(all(cfg.kwargs['compile_mode'] == 'simd_simt_template' for cfg in template))
+        self.assertTrue(all(cfg.kwargs['compile_mode'] == 'simt_only' for cfg in simt))
+
+    def test_many_inputs_keep_the_minimum_persistent_tile(self):
+        generator = TileGenerator(
+            [768, 2048], ['x0', 'r1'], [0, 1], [], [0], [1], True, torch.float32,
+            NPUKernelType.SIMT_TEMPLATE, input_ptr_num=83,
+        )
+        configs = generator.descend_split_tiling()
+        self.assertEqual(generator.input_ptr_num, 83)
+        self.assertTrue(configs)
+        self.assertTrue(all(cfg.kwargs['X0BLOCK_SUB'] == 1 for cfg in configs))
+        self.assertTrue(all(cfg.kwargs['R1BLOCK_SUB'] == 2048 for cfg in configs))
+
+    def test_no_loop_selection_counts_persistent_axes(self):
+        generator = TileGenerator(
+            [4, 64, 512, 512], ['z0', 'y1', 'x2', 'r3'], [0, 1, 2, 3], [], [0, 1], [2, 3],
+            True, torch.float32, NPUKernelType.SIMT_TEMPLATE, input_ptr_num=2,
+        )
+        self.assertNotIn(2, generator.no_loop_axis)
+        configs = generator.descend_split_tiling()
+        self.assertTrue(configs)
+        self.assertTrue(any(cfg.kwargs['X2BLOCK_SUB'] <= 8 for cfg in configs))
+
+
+if __name__ == '__main__':
+    run_tests()
